DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Runs the Solid Queue supervisor (and the config/recurring.yml schedule) inside Puma.
# No effect on Windows (fork() is unimplemented there) -- run `bin/jobs` in a separate
# terminal alongside `bin/rails s` instead.
SOLID_QUEUE_IN_PUMA=true

# Overrides for the test environment (falls back to the values above if unset)
DATABASE_TEST_HOST=localhost
DATABASE_TEST_PORT=5432
DATABASE_TEST_USERNAME=postgres
DATABASE_TEST_PASSWORD=postgres

# Production connection (no fallback — must be set at deploy time)
DATABASE_PROD_HOST=
DATABASE_PROD_PORT=5432
DATABASE_PROD_USERNAME=postgres
DATABASE_PROD_PASSWORD=postgres
